---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import PracticeAreas from '../components/PracticeAreas.astro';
import QuoteSection from '../components/QuoteSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { siteInfo } from '../data/site';

const pageDescription = 'Advocacia tributária e soluções fiscais para empresários e empresas.';
---

<BaseLayout title={siteInfo.name} description={pageDescription}>
  <SiteHeader />
  <main>
    <Hero />
    <About />
    <PracticeAreas />
    <QuoteSection />
    <ContactSection />
  </main>
  <SiteFooter />
  <WhatsAppFab />
</BaseLayout>
