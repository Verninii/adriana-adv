---
import Button from './ui/Button.astro';
import Logo from './ui/Logo.astro';
import { navLinks, whatsappUrl } from '../data/site';
---

<header class="header">
  <div class="header__inner">
    <a href="#inicio" class="header__brand">
      <Logo class="header__logo" loading="eager" />
    </a>
    <div class="header__actions">
      <nav class="header__nav" aria-label="Navegação principal">
        {
          navLinks.map((link) => (
            <a href={link.href} class="header__link">
              {link.label}
            </a>
          ))
        }
      </nav>
      <Button href={whatsappUrl} external>Entre em contato</Button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding: 14px var(--container-padding-x);
  }

  .header__brand {
    display: flex;
    align-items: center;
  }

  .header__logo {
    width: auto;
    height: 52px;
  }

  .header__actions {
    display: flex;
    align-items: center;
  }

  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__link {
    padding: 12px 20px;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream-dim);
    transition: color var(--transition-base);
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--gold-300);
  }

  @media (max-width: 860px) {
    .header__nav {
      display: none;
    }
  }
</style>
