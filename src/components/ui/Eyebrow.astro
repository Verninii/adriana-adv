---
interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<span class:list={['eyebrow', className]} {...rest}><slot /></span>

<style>
  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
</style>
