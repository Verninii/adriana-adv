---
import type { IconName } from '../../types/content';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className, ...rest } = Astro.props;

const strokeIcons: Partial<Record<IconName, string>> = {
  shield:
    '<path d="M12 3.2 5 6v5.4c0 4.2 2.8 7.6 7 9.4 4.2-1.8 7-5.2 7-9.4V6z"></path><path d="M9.2 12.2 11.3 14.4l3.8-4"></path>',
  'trending-down':
    '<path d="M3.6 7.6 10 14l3.2-3.2 7.2 7.2"></path><path d="M20.4 12.8v5.2h-5.2"></path>',
  handshake:
    '<path d="M3 9.6 7.2 6h3.2l1.6 1.6L10.4 9.2a1.6 1.6 0 0 0 0 2.3l.2.2a1.6 1.6 0 0 0 2.2 0L16 8.4"></path><path d="M13.6 6h3.2L21 9.6"></path><path d="m13.2 12.4 3.6 3.4"></path><path d="m11 14.4 2.8 2.7"></path><path d="M3 9.6v4.2l3.4 3.4h2.2l2 2"></path>',
  lock: '<rect x="4.6" y="10.4" width="14.8" height="10.2" rx="2"></rect><path d="M8.2 10.4V7.8a3.8 3.8 0 0 1 7.6 0v2.6"></path><path d="M12 14.4v2.4"></path>',
  instagram:
    '<rect x="3.8" y="3.8" width="16.4" height="16.4" rx="4.6"></rect><circle cx="12" cy="12" r="3.8"></circle><path d="M16.9 7.1h.01"></path>',
  'arrow-right': '<path d="M4 12h15"></path><path d="M13.4 6.4 19.6 12l-6.2 5.6"></path>',
};

const filledIcons: Partial<Record<IconName, string>> = {
  whatsapp:
    '<path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.36.66 4.56 1.8 6.44L4 29l7.72-1.75a11.98 11.98 0 0 0 4.3.8c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3zm0 21.86c-1.5 0-2.94-.4-4.2-1.16l-.3-.18-4.58 1.04 1.06-4.47-.2-.32a9.83 9.83 0 0 1-1.5-5.19c0-5.44 4.43-9.87 9.87-9.87a9.8 9.8 0 0 1 6.98 2.89 9.79 9.79 0 0 1 2.89 6.98c0 5.44-4.43 9.87-9.87 9.87zm5.4-7.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.15-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.34.44-.5.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.18-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.06 2.9 1.21 3.1c.15.2 2.09 3.2 5.07 4.48.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.75-.71 2-1.4.24-.68.24-1.27.17-1.4-.07-.12-.27-.2-.57-.35z"></path>',
};

const isFilled = name in filledIcons;
const paths = (isFilled ? filledIcons[name] : strokeIcons[name]) ?? '';
const viewBox = isFilled ? '0 0 32 32' : '0 0 24 24';
---

<svg
  viewBox={viewBox}
  width={size}
  height={size}
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? undefined : 'currentColor'}
  stroke-width={isFilled ? undefined : 1.4}
  stroke-linecap={isFilled ? undefined : 'round'}
  stroke-linejoin={isFilled ? undefined : 'round'}
  aria-hidden="true"
  class={className}
  set:html={paths}
  {...rest}
/>
