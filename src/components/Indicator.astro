---
import type { Credential } from '../types/content';

type Props = Credential;

const { value, label } = Astro.props;
---

<div class="indicator">
  <span class="indicator__value">{value}</span>
  <span class="indicator__label">{label}</span>
</div>

<style>
  .indicator {
    display: flex;
    flex-direction: column;
    padding-left: 14px;
    border-left: 2px solid var(--gold-500);
  }

  .indicator__value {
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--gold-300);
  }

  .indicator__label {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--cream-dim);
    white-space: pre-line;
  }
</style>
