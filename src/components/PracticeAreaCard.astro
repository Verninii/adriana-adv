---
import Icon from './ui/Icon.astro';
import type { PracticeArea } from '../types/content';

type Props = PracticeArea;

const { icon, mark, title, description } = Astro.props;
---

<article class="area-card">
  <span class="area-card__badge">
    <Icon name={icon} size={26} />
  </span>
  <span class="area-card__mark">{mark}</span>
  <h3 class="area-card__title">{title}</h3>
  <p class="area-card__description">{description}</p>
</article>

<style>
  .area-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 26px;
    padding: 42px 28px 26px;
    background: var(--surface-card);
    border: 1px solid var(--gold-clear);
    border-top-color: var(--gold-500);
    border-left-color: var(--gold-500);
    border-radius: var(--radius-lg);
    transition: border-color 260ms ease;
  }

  .area-card:hover {
    border-color: var(--gold-500);
  }

  .area-card__badge {
    position: absolute;
    top: 0;
    left: 28px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: linear-gradient(150deg, var(--gold-500), var(--gold-600));
    color: var(--cream);
    box-shadow: var(--shadow-gold);
  }

  .area-card__mark {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.2;
    color: var(--gold-300);
    margin-bottom: 8px;
  }

  .area-card__title {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }

  .area-card__description {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-soft);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .area-card {
      transition: none;
    }
  }
</style>
