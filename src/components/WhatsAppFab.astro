---
import { whatsappUrl } from '../data/site';
---

<a class="fab" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
  <svg class="fab__icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path
      d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.36.66 4.56 1.8 6.44L4 29l7.72-1.75a11.98 11.98 0 0 0 4.3.8c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3zm0 21.86c-1.5 0-2.94-.4-4.2-1.16l-.3-.18-4.58 1.04 1.06-4.47-.2-.32a9.83 9.83 0 0 1-1.5-5.19c0-5.44 4.43-9.87 9.87-9.87a9.8 9.8 0 0 1 6.98 2.89 9.79 9.79 0 0 1 2.89 6.98c0 5.44-4.43 9.87-9.87 9.87zm5.4-7.4c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.15-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.34.44-.5.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.18-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.06 2.9 1.21 3.1c.15.2 2.09 3.2 5.07 4.48.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.75-.71 2-1.4.24-.68.24-1.27.17-1.4-.07-.12-.27-.2-.57-.35z"
    ></path>
  </svg>
  <span class="fab__label">WhatsApp</span>
</a>

<style>
  .fab {
    position: fixed;
    right: max(20px, env(safe-area-inset-right, 0px));
    bottom: max(20px, env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px 12px 14px;
    background: var(--whatsapp);
    color: var(--whatsapp-ink);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    box-shadow: var(--shadow-fab);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .fab:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-fab-hover);
  }

  .fab:focus-visible {
    outline: 2px solid var(--gold-300);
    outline-offset: 3px;
  }

  .fab__icon {
    flex: none;
    width: 24px;
    height: 24px;
  }

  @media (max-width: 480px) {
    .fab {
      padding: 14px;
    }

    .fab__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab {
      transition: none;
    }
  }
</style>
