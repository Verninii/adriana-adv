---
import FloatingLines from './ui/FloatingLines.astro';
import { siteInfo } from '../data/site';
---

<section class="quote">
  <div class="quote__lines" aria-hidden="true">
    <FloatingLines
      enabledWaves={['middle', 'bottom', 'top' ]}
      interactive={false}
      parallax={false}
      lineCount={6}
      lineDistance={33.5}
      bendRadius={24.5}
      bendStrength={-4.5}
      parallaxStrength={0.50}
      animationSpeed={0.6}
      linesGradient={['#a9803a', '#c9a24a', '#e3cf94']}
    />
  </div>

  <div class="quote__inner">
    <blockquote class="quote__block">
      <span class="quote__mark" aria-hidden="true">&ldquo;</span>
      <p class="quote__text">
        No escritório {siteInfo.name} Advocacia, focamos primeiro na dor do cliente, não enxergamos
        somente honorários, mas o ser humano que precisa deitar no seu travesseiro e ter o seu sono
        tranquilo.
      </p>
      <footer class="quote__author">{siteInfo.nameFooter}</footer>
    </blockquote>
  </div>
</section>

<style>
  .quote {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--gold-500);
  }

  .quote__lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .quote__inner {
    position: relative;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding-inline: var(--container-padding-x);
  }

  .quote__block {
    position: relative;
    z-index: 0;
    max-width: 760px;
    margin: 0 auto;
    padding-top: 10px;
    text-align: center;
  }

  .quote__block::before {
    content: '';
    position: absolute;
    inset: -18% -10%;
    z-index: -1;
    /* background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.7) 45%,
      rgba(0, 0, 0, 0) 74%
    ); */
    pointer-events: none;
  }

  .quote__mark {
    display: block;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 0;
    color: var(--gold-500);
    margin-bottom: 10px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
  }

  .quote__text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1.6vw + 1rem, 1.7rem);
    line-height: 1.5;
    color: var(--cream);
    margin: 0 0 22px;
    text-shadow:
      -1px -1px 0 rgba(0, 0, 0, 0.7),
      1px -1px 0 rgba(0, 0, 0, 0.7),
      -1px 1px 0 rgba(0, 0, 0, 0.7),
      1px 1px 0 rgba(0, 0, 0, 0.7),
      0 2px 10px rgba(0, 0, 0, 0.85),
      0 0 26px rgba(0, 0, 0, 0.6);
  }

  .quote__author {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--gold-300);
    text-shadow:
      -1px -1px 0 rgba(0, 0, 0, 0.7),
      1px -1px 0 rgba(0, 0, 0, 0.7),
      -1px 1px 0 rgba(0, 0, 0, 0.7),
      1px 1px 0 rgba(0, 0, 0, 0.7),
      0 2px 12px rgba(0, 0, 0, 0.85);
  }
</style>
