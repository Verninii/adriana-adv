---
import { getImage } from 'astro:assets';
import Button from './ui/Button.astro';
import BlurText from './ui/BlurText.astro';
import Eyebrow from './ui/Eyebrow.astro';
import StrokeText from './ui/StrokeText.astro';
import background from '../assets/new-bg-hero.png';
import { siteInfo, whatsappUrl } from '../data/site';

const backgroundImage = await getImage({ src: background, format: 'webp', width: 1900 });
const backgroundUrl = `url(${backgroundImage.src})`;
const nameParts = siteInfo.name.split(' ');
---

<section id="inicio" class="hero">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">
        {
          nameParts.map((part) => (
            <StrokeText class="hero__title-line" text={part} height="clamp(2.8rem, 5vw + 1rem, 4.6rem)" />
          ))
        }
      </h1>
      <p class="hero__role">{siteInfo.role}</p>
      <BlurText
        class="hero__lede"
        maxWidth="70%"
        text="Advogada tributarista com atuação estratégica voltada à defesa de empresários e empresas em situações de endividamento fiscal, execuções tributárias e negociações com o Fisco."
      />
      <div class="hero__actions" data-reveal={JSON.stringify({ direction: 'up', distance: '40px', stagger: 160, duration: 600 })}>
        <Button href={whatsappUrl} external>Falar no WhatsApp</Button>
        <Button href="#atuacao" variant="secondary">Áreas de atuação</Button>
      </div>
    </div>
  </div>
</section>

<style define:vars={{ backgroundUrl }}>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 740px;
    padding-block: 72px 88px;
    background-color: var(--navy-950);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: var(--backgroundUrl);
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(6, 15, 28, 0) 62%, rgba(6, 15, 28, 1) 100%),
      linear-gradient(
        100deg,
        rgba(6, 15, 28, 0.95) 0%,
        rgba(6, 15, 28, 0.88) 38%,
        rgba(6, 15, 28, 0.55) 62%,
        rgba(6, 15, 28, 0.3) 100%
      );
  }

  .hero__inner {
    width: 100%;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding-inline: var(--container-padding-x);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 560px;
  }

  .hero__eyebrow {
    margin-bottom: 18px;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin-bottom: 20px;
  }

  .hero__title-line {
    display: block;
  }

  .hero__role {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--gold-300);
    margin: 0 0 22px;
  }

  .hero__lede {
    max-width: 46ch;
    font-size: 1.05rem;
    color: var(--cream-dim);
    margin: 0 0 32px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (max-width: 860px) {
    .hero {
      align-items: flex-end;
      min-height: 620px;
      padding-block: clamp(100px, 30vh, 460px) 30px;
    }

    .hero__backdrop {
      background-position: 86% center;
    }

    .hero__overlay {
      background: linear-gradient(
        to bottom,
        rgba(6, 15, 28, 0.25) 0%,
        rgba(6, 15, 28, 0.45) 30%,
        rgba(6, 15, 28, 0.92) 52%,
        rgba(6, 15, 28, 1) 100%
      );
    }

    .hero__copy {
      max-width: none;
    }
  }
</style>
