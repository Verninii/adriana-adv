---
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';
import portrait from '../assets/new-professional-photo.jpeg';
import { siteInfo, whatsappUrl } from '../data/site';
import { heroHighlight } from '../data/stats';

const nameParts = siteInfo.name.split(' ');
const portraitAlt = `${siteInfo.name}, advogada tributarista`;
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <Eyebrow class="hero__eyebrow">Bem-vinda(o)</Eyebrow>
      <h1 class="hero__title">
        {nameParts.map((part) => <span class="hero__title-line">{part}</span>)}
      </h1>
      <p class="hero__role">{siteInfo.role}</p>
      <p class="hero__lede">
        Advogada tributarista com atuação estratégica voltada à defesa de empresários e empresas em
        situações de endividamento fiscal, execuções tributárias e negociações com o Fisco.
      </p>
      <div class="hero__actions">
        <Button href={whatsappUrl} external>Falar no WhatsApp</Button>
        <Button href="#atuacao" variant="secondary">Áreas de atuação</Button>
      </div>
    </div>

    <div class="hero__photo">
      <div class="hero__frame">
        <Image
          src={portrait}
          alt={portraitAlt}
          class="hero__image"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero__tag">
        <span class="hero__tag-value">{heroHighlight.value}</span>
        <span class="hero__tag-label">{heroHighlight.label}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(201, 162, 74, 0.14), transparent 60%),
      linear-gradient(160deg, var(--navy-900), var(--navy-950) 70%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 48px;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding: 56px var(--container-padding-x) 64px;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__eyebrow {
    margin-bottom: 18px;
  }

  .hero__title {
    font-size: clamp(2.6rem, 5vw + 1rem, 4.3rem);
    line-height: 1.04;
    margin-bottom: 20px;
  }

  .hero__title-line {
    display: block;
  }

  .hero__role {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--gold-300);
    margin: 0 0 22px;
  }

  .hero__lede {
    max-width: 46ch;
    font-size: 1.05rem;
    color: var(--cream-dim);
    margin: 0 0 32px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__photo {
    position: relative;
    justify-self: center;
    z-index: 1;
  }

  .hero__photo::before {
    content: '';
    position: absolute;
    inset: -10% -18%;
    background: radial-gradient(
      ellipse at center,
      rgba(4, 10, 20, 0.85),
      rgba(4, 10, 20, 0.4) 55%,
      transparent 75%
    );
    filter: blur(42px);
    z-index: -1;
  }

  .hero__frame {
    position: relative;
    width: min(400px, 84vw);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-photo), var(--shadow);
  }

  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, transparent 42%, rgba(6, 15, 28, 0.7));
    pointer-events: none;
  }

  .hero__image {
    width: 100%;
    height: auto;
    aspect-ratio: 680 / 1280;
    object-fit: cover;
    object-position: top center;
  }

  .hero__tag {
    position: absolute;
    bottom: -18px;
    left: -18px;
    display: flex;
    flex-direction: column;
    max-width: 220px;
    padding: 12px 18px;
    background: var(--navy-800);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }

  .hero__tag-value {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--gold-300);
  }

  .hero__tag-label {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--cream-dim);
    margin-top: 4px;
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
      padding-block: 36px 40px;
    }

    .hero__photo {
      order: -1;
      max-width: 320px;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .hero__tag {
      display: none;
    }
  }
</style>
