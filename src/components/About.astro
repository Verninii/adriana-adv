---
import { getImage } from 'astro:assets';
import Accent from './ui/Accent.astro';
import SectionHeading from './ui/SectionHeading.astro';
import Indicator from './Indicator.astro';
import background from '../assets/bg-veda-justica.png';
import { siteInfo } from '../data/site';
import { aboutStats } from '../data/stats';

const backgroundImage = await getImage({ src: background, format: 'webp', width: 2000 });
const backgroundUrl = `url(${backgroundImage.src})`;
---

<section id="sobre" class="about">
  <div class="about__backdrop" aria-hidden="true"></div>
  <div class="about__overlay" aria-hidden="true"></div>

  <div class="about__inner">
    <div class="about__content">
      <SectionHeading eyebrow="Sobre mim">
        A advocacia tem o poder de <Accent>mudar vidas</Accent>
      </SectionHeading>

      <p class="about__text">
        {siteInfo.name} é advogada tributarista com atuação estratégica voltada à defesa de
        empresários e empresas em situações de endividamento fiscal, execuções tributárias e
        negociações com o Fisco.
      </p>
      <p class="about__text">
        No escritório {siteInfo.name} Advocacia, o foco está primeiro na dor do cliente — não apenas
        nos honorários, mas no ser humano que precisa deitar no travesseiro e ter o sono tranquilo.
      </p>
      <div class="about__stats">
        {aboutStats.map((stat) => <Indicator {...stat} />)}
      </div>
    </div>
  </div>
</section>

<style define:vars={{ backgroundUrl }}>
  .about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 640px;
    padding-block: 72px 80px;
    background-color: var(--navy-950);
  }

  .about__backdrop {
    position: absolute;
    inset: -12px;
    z-index: -2;
    background-image: var(--backgroundUrl);
    background-size: cover;
    background-position: center left;
    background-repeat: no-repeat;
    filter: blur(1.5px);
  }

  .about__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(6, 15, 28, 0) 62%, rgba(6, 15, 28, 1) 100%),
      linear-gradient(
        100deg,
        rgba(6, 15, 28, 0.7) 0%,
        rgba(6, 15, 28, 0.8) 45%,
        rgba(6, 15, 28, 0.9) 100%
      );
  }

  .about__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 56px;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding-inline: var(--container-padding-x);
  }

  .about__content {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about__text {
    font-size: 1.06rem;
    color: var(--cream-dim);
    margin: 18px 0 0;
  }

  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 32px;
  }

  @media (max-width: 780px) {
    .about {
      min-height: 0;
      padding-block: 56px 72px;
    }

    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__content {
      grid-column: 1;
    }
  }
</style>
