---
import { getImage } from 'astro:assets';
import BlurText from './ui/BlurText.astro';
import Eyebrow from './ui/Eyebrow.astro';
import StrokeText from './ui/StrokeText.astro';
import Indicator from './Indicator.astro';
import background from '../assets/bg-veda-justica.png';
import { siteInfo } from '../data/site';
import { aboutStats } from '../data/stats';

const backgroundImage = await getImage({ src: background, format: 'webp', width: 2000 });
const backgroundUrl = `url(${backgroundImage.src})`;
const aboutIntro = `${siteInfo.name} é advogada tributarista com atuação estratégica voltada à defesa de empresários e empresas em situações de endividamento fiscal, execuções tributárias e negociações com o Fisco.`;
const aboutApproach = `No escritório ${siteInfo.name} Advocacia, o foco está primeiro na dor do cliente — não apenas nos honorários, mas no ser humano que precisa deitar no travesseiro e ter o sono tranquilo.`;
---

<section id="sobre" class="about">
  <div class="about__backdrop" aria-hidden="true"></div>
  <div class="about__overlay" aria-hidden="true"></div>

  <div class="about__inner">
    <div class="about__content">
      <Eyebrow class="about__eyebrow">Sobre mim</Eyebrow>
      <h2 class="about__title">
        <StrokeText text="A advocacia tem o poder de" height="clamp(1.9rem, 2.4vw + 1rem, 2.7rem)" />
        <StrokeText accent="mudar vidas" text="" height="clamp(1.9rem, 2.4vw + 1rem, 2.7rem)" />
      </h2>

      <BlurText class="about__text" text={aboutIntro} />
      <BlurText class="about__text" text={aboutApproach} />
      <div class="about__stats" data-reveal={JSON.stringify({ direction: 'left', distance: '60px', stagger: 150, duration: 600 })}>
        {aboutStats.map((stat) => <Indicator {...stat} />)}
      </div>
    </div>
  </div>
</section>

<style define:vars={{ backgroundUrl }}>
  .about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 640px;
    padding-block: 72px 80px;
    background-color: var(--navy-950);
  }

  .about__backdrop {
    position: absolute;
    inset: -12px;
    z-index: -2;
    background-image: var(--backgroundUrl);
    background-size: cover;
    background-position: center left;
    background-repeat: no-repeat;
    filter: blur(1.5px);
  }

  .about__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(6, 15, 28, 0) 62%, rgba(6, 15, 28, 1) 100%),
      linear-gradient(
        100deg,
        rgba(6, 15, 28, 0.7) 0%,
        rgba(6, 15, 28, 0.8) 45%,
        rgba(6, 15, 28, 0.9) 100%
      );
  }

  .about__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: 56px;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding-inline: var(--container-padding-x);
  }

  .about__content {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .about__eyebrow {
    margin-bottom: 14px;
  }

  .about__title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 8px;
  }

  .about__text {
    font-size: 1.06rem;
    color: var(--cream-dim);
    margin: 18px 0 0;
  }

  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 32px;
  }

  @media (max-width: 780px) {
    .about {
      min-height: 0;
      padding-block: 56px 72px;
    }

    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__content {
      grid-column: 1;
    }
  }
</style>
