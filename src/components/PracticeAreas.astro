---
import { getImage } from 'astro:assets';
import Eyebrow from './ui/Eyebrow.astro';
import StrokeText from './ui/StrokeText.astro';
import PracticeAreaCard from './PracticeAreaCard.astro';
import background from '../assets/new-bg-right.png';
import { practiceAreas } from '../data/practiceAreas';

const backgroundImage = await getImage({ src: background, format: 'webp', width: 1800 });
const backgroundUrl = `url(${backgroundImage.src})`;
---

<section id="atuacao" class="areas">
  <div class="areas__backdrop" aria-hidden="true"></div>
  <div class="areas__overlay" aria-hidden="true"></div>
  <div class="areas__inner">
    <div class="areas__heading">
      <Eyebrow class="areas__eyebrow">Área de atuação</Eyebrow>
      <h2 class="areas__title">
        <StrokeText text="Especialista em soluções de" height="clamp(1.9rem, 2.4vw + 1rem, 2.7rem)" />
        <StrokeText text="" accent="dívidas fiscais" height="clamp(1.9rem, 2.4vw + 1rem, 2.7rem)" />
      </h2>
    </div>

    <div class="areas__grid" data-reveal>
      {practiceAreas.map((area) => <PracticeAreaCard {...area} />)}
    </div>
  </div>
</section>

<style define:vars={{ backgroundUrl }}>
  .areas {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--navy-950);
  }

  .areas__backdrop {
    position: absolute;
    inset: -12px;
    z-index: -2;
    background-image: var(--backgroundUrl);
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    filter: blur(1.5px);
  }

  .areas__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(6, 15, 28, 1) 0%, rgba(6, 15, 28, 0) 26%),
      linear-gradient(
        100deg,
        rgba(6, 15, 28, 0.94) 0%,
        rgba(6, 15, 28, 0.88) 55%,
        rgba(6, 15, 28, 0.82) 100%
      );
  }

  .areas__inner {
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: var(--container-outer-max);
    margin: 0 auto;
    padding-inline: var(--container-padding-x);
  }

  .areas__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .areas__title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 14px;
  }

  .areas__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 52px 20px;
    padding-top: 26px;
  }

  @media (max-width: 700px) {
    .areas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

